CAMPAIGNHUB_APP_NAME=CampaignHub
CAMPAIGNHUB_ENVIRONMENT=development
CAMPAIGNHUB_DEBUG=false
CAMPAIGNHUB_LOG_LEVEL=INFO
CAMPAIGNHUB_API_V1_PREFIX=/api/v1

CAMPAIGNHUB_DATABASE_URL=postgresql+asyncpg://campaignhub:campaignhub_local@localhost:5435/campaignhub
CAMPAIGNHUB_DATABASE_ECHO=false
CAMPAIGNHUB_DATABASE_POOL_SIZE=5
CAMPAIGNHUB_DATABASE_MAX_OVERFLOW=10

# Generate a random signing key locally: uv run python -c "import secrets; print(secrets.token_hex(32))"
# Add CAMPAIGNHUB_JWT_SECRET_KEY=<generated value> to your private .env.
# Required for authentication in all environments and for production startup.
CAMPAIGNHUB_JWT_ISSUER=campaignhub
CAMPAIGNHUB_JWT_AUDIENCE=campaignhub-api
CAMPAIGNHUB_ACCESS_TOKEN_LIFETIME_SECONDS=900
